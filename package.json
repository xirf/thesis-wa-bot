{
  "name": "thesis-wa-bot",
  "version": "1.0.2",
  "description": "Bot to help communication between lecturer and student",
  "main": "src/index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts --ignore-watch node_modules --ignore-watch config",
    "start": "node dist/src/index.js",
    "prebuild": "rm -rf dist && mkdir dist && mkdir dist/misc && cp -r misc/* dist/misc/",
    "build": "tsc",
    "postbuild": "cp -r src/web/views dist/src/web/views",
    "preprod": "npm run build",
    "prod": "pm2 start ecosystem.config.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xirf/thesis-wa-bot.git"
  },
  "keywords": [
    "bot",
    "whatsapp-bot",
    "baileys"
  ],
  "author": "xirf",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/xirf/thesis-wa-bot/issues"
  },
  "homepage": "https://github.com/xirf/thesis-wa-bot#readme",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@prisma/client": "^5.19.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.5",
    "@whiskeysockets/baileys": "^6.7.7",
    "cookie-parser": "^1.4.6",
    "cronstrue": "^2.50.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-handlebars": "^7.1.3",
    "fastify": "^4.28.1",
    "html-pdf-node": "^1.0.8",
    "html-to-pdfmake": "^2.5.13",
    "jimp": "^0.22.12",
    "jsdom": "^24.1.3",
    "link-preview-js": "^3.0.5",
    "mysql2": "^3.11.0",
    "node-cache": "^5.1.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.14.0",
    "pdfmake": "^0.2.12",
    "pino": "^8.21.0",
    "pino-pretty": "^10.3.1",
    "pm2": "^5.4.2",
    "puppeteer": "^21.11.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "reflect-metadata": "^0.1.14",
    "ts-node-dev": "^2.0.0",
    "whatsapp-web.js": "^1.25.0"
  },
  "devDependencies": {
    "@types/body-parser": "^1.19.5",
    "@types/node": "^20.16.2",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/validator": "^13.12.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^5.19.0",
    "typescript": "^5.5.4"
  }
}